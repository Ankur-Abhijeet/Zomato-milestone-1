# Hugging Face cache (optional; defaults to ./.cache/huggingface)
# HF_HOME=./.cache/huggingface

# Restaurant parquet cache (optional; defaults to ./.cache/restaurants.parquet)
# RESTAURANT_CACHE_PATH=./.cache/restaurants.parquet

# Budget bands: approximate cost for two (INR)
# BUDGET_LOW_MAX=500
# BUDGET_MEDIUM_MAX=1500

# Dataset
# HF_DATASET_ID=ManikaSaini/zomato-restaurant-recommendation

# User preference defaults (Phase 2)
# DEFAULT_MIN_RATING=3.0
# DEFAULT_BUDGET=medium
# ADDITIONAL_MAX_LENGTH=500

# Phase 3: integration / prompt
# CANDIDATE_CAP=30
# CANDIDATE_CAP_MAX=50
# RECOMMENDATION_TOP_K=5
# PROMPT_FIELD_MAX_LENGTH=120
# LOG_PROMPTS=false

# Phase 4: Groq LLM (https://console.groq.com)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_TEMPERATURE=0.2
# GROQ_MAX_TOKENS=2048
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=3
# LLM_RETRY_BACKOFF_SECONDS=2
# LOG_LLM_RESPONSES=false

# Phase 6: CORS (Optional)
# ALLOWED_ORIGINS=https://yourproductiondomain.vercel.app,http://localhost:5173
